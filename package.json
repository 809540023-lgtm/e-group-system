{
  "name": "jp-proxy-blueprint",
  "version": "0.1.0",
  "private": true,
  "description": "日本日貨代購系統 — 商品來源、交易、採購、物流、客服與廣告的單一紀錄平台",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @jp/web",
    "dev:worker": "npm run dev --workspace @jp/worker",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:migrate": "node --experimental-strip-types packages/db/src/cli/migrate.ts",
    "db:smoke": "node --experimental-strip-types packages/db/src/cli/smoke.ts",
    "sync:preview": "node --experimental-strip-types apps/worker/src/cli/sync-preview.ts",
    "start:worker": "npm run start --workspace @jp/worker",
    "start:web": "npm run start --workspace @jp/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
