# 複製為 .env 後填入實際值。正式憑證只放 secret store 或私密 env，不進 Git。
NODE_ENV=development
APP_ENV=dev

# 資料庫（web / worker / reporter 使用各自最小權限角色，不用管理帳號）
DATABASE_URL=postgres://jp_web:jp_web_dev@127.0.0.1:5432/jp_dev
DATABASE_URL_WORKER=postgres://jp_worker:jp_worker_dev@127.0.0.1:5432/jp_dev
DATABASE_URL_REPORTER=postgres://jp_reporter:jp_reporter_dev@127.0.0.1:5432/jp_dev

# 對外網址
PUBLIC_BASE_URL=http://127.0.0.1:3000

# 工作階段與簽章（正式環境必須更換為隨機長字串）
SESSION_SECRET=dev-only-session-secret-change-me
QUOTE_SIGNING_SECRET=dev-only-quote-secret-change-me

# Google 商品來源（只讀；服務帳號或 workload identity）
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPROVED_CATALOG_SHEET_ID=
GOOGLE_DRIVE_SOURCE_FOLDER_ID=

# 綠界金流（服務端保管，絕不進前端）
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_ENV=stage

# LINE 官方帳號
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_STAFF_GROUP_ID=

# 廣告（未取得資格時保持 disabled）
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
OPENAI_ADS_API_KEY=

# AI（預設 desktop_manual，不呼叫付費 API）
AI_MODE=desktop_manual
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
AI_DAILY_BUDGET_TWD=0

# ── 雙北捷運健康餐食節點網路（apps/egroup）────────────────────────────
# 主資料庫；整合測試會自動建立 egroup_test 並套用 migration。
EGROUP_DATABASE_URL=postgres://127.0.0.1:5432/egroup_dev
EGROUP_TEST_DATABASE_URL=postgres://127.0.0.1:5432/egroup_test
# 工作階段簽章與取貨碼雜湊（正式環境必須更換為隨機長字串）
# 正式環境（NODE_ENV=production 或 EGROUP_ENV=production）若未設定或仍為下列預設值，
# 啟動時會直接失敗（EGROUP_ENV_INVALID），不會以已知預設值簽章。
EGROUP_SESSION_SECRET=dev-only-egroup-session-secret-change-me
EGROUP_PICKUP_SECRET=dev-only-egroup-pickup-secret-change-me
